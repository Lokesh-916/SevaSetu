# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SevaSetu
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Database (SQLite – local dev) ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./sevasetu.db
DB_ECHO=false

# ── Security (change before any real deployment!) ─────────────────────────────
SECRET_KEY=dev-secret-key-change-me-in-production

# ── Logging ───────────────────────────────────────────────────────────────────
# LOG_FORMAT: "text" for coloured terminal output, "json" for structured logs
LOG_LEVEL=INFO
LOG_FORMAT=text
