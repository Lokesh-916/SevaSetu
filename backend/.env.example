# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SevaSetu
APP_VERSION=1.0.0
ENVIRONMENT=production
DEBUG=false

# ── API ───────────────────────────────────────────────────────────────────────
API_PREFIX=/api/v1
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ── Database ──────────────────────────────────────────────────────────────────
# Use absolute path for Docker: /app/data/sevasetu.db
DATABASE_URL=sqlite+aiosqlite:////app/data/sevasetu.db
DB_ECHO=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── AI / LLM (AWS Bedrock) ───────────────────────────────────────────────────
# NOTE: AWS credentials are NOT stored here!
# The application uses IAM roles when running on EC2.
# boto3 automatically discovers credentials from the EC2 instance metadata service.
#
# Required IAM permissions for the EC2 instance role:
# - bedrock:InvokeModel on the model ARN below
#
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
